{
  "manifest_version": 3,
  "name": "Vigil Companion",
  "version": "0.3.5",
  "key": "",
  "description": "Connects browser tabs to the local Vigil blocker.",
  "permissions": ["tabs", "webNavigation", "storage", "declarativeNetRequest", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Vigil"
  }
}
