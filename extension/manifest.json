{
  "manifest_version": 3,
  "minimum_chrome_version": "101",
  "name": "Vigil Companion",
  "version": "0.3.6",
  "key": "",
  "description": "Connects browser tabs to the local Vigil blocker.",
  "permissions": ["tabs", "webNavigation", "storage", "declarativeNetRequest", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "vigil_always_on_search_protection",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["google-safe-search.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "Vigil"
  }
}
