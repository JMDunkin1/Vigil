{
  "manifest_version": 3,
  "name": "Vigil Focused Web Controls",
  "version": "0.1.5",
  "description": "Adds focused YouTube controls, locks Reddit adult-content controls, and filters explicit media titles across websites.",
  "host_permissions": [
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://reddit.com/*",
    "https://*.reddit.com/*",
    "https://redd.it/*",
    "https://*.redd.it/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://reddit.com/*",
        "https://*.reddit.com/*",
        "https://redd.it/*",
        "https://*.redd.it/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*"
      ],
      "js": [
        "reddit-child-lock.js",
        "youtube-parity.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-limits.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "search-guard.js",
        "media-child-lock.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "webNavigation",
    "storage"
  ],
  "background": {
    "scripts": [
      "youtube-background.js"
    ]
  },
  "action": {
    "default_title": "Vigil YouTube Controls",
    "default_popup": "status.html",
    "default_icon": {
      "32": "icons/toolbar.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
