{
  "manifest_version": 3,
  "name": "Vigil YouTube Controls",
  "version": "0.1.0",
  "description": "Adds focused mobile-player gestures while Vigil's separate content blocker keeps YouTube Shorts unavailable.",
  "host_permissions": [
    "https://youtube.com/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://youtube.com/*",
      "https://www.youtube.com/*",
      "https://m.youtube.com/*"
    ],
    "js": ["youtube-parity.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
