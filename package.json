{
  "name": "vigil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/runtime/app/main.js",
  "author": "James Dunkin",
  "description": "A local-first focus enforcement app for macOS.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CaseLine-tech/Vigil.git"
  },
  "scripts": {
    "app": "npm run build && electron .",
    "build": "node scripts/prepare-build-dir.mjs && rm -rf dist/runtime && tsc -p tsconfig.json && node scripts/build-human-idle-helper.mjs && node dist/runtime/scripts/copy-assets.mjs && node dist/runtime/scripts/write-build-info.mjs",
    "build:mac": "npm run build && npm run package:mac",
    "package:mac": "node scripts/prepare-mac-output.mjs && node scripts/package-mac.mjs dir && node scripts/hide-mac-build.mjs",
    "dist:mac": "npm run build && npm run package:mac:dmg",
    "package:mac:dmg": "node scripts/prepare-mac-output.mjs && node scripts/package-mac.mjs dmg && node scripts/hide-mac-build.mjs",
    "build:mac:signed": "npm run build && node scripts/prepare-mac-output.mjs && electron-builder --mac dir && node scripts/hide-mac-build.mjs",
    "dist:mac:signed": "npm run build && node scripts/prepare-mac-output.mjs && electron-builder --mac dmg && node scripts/hide-mac-build.mjs",
    "release:mac": "npm run build && node scripts/prepare-mac-output.mjs && node scripts/release-mac.mjs",
    "start": "npm run build && node dist/runtime/src/server.js",
    "dev": "node --watch --watch-preserve-output --watch-path=app --watch-path=src --watch-path=public --watch-path=extension --watch-path=scripts --watch-path=tsconfig.json --watch-path=package.json scripts/dev.mjs",
    "test": "npm run build && npm run test:runtime",
    "test:runtime": "node dist/runtime/scripts/run-tests.mjs",
    "lint": "eslint . && node scripts/lint-source.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm test",
    "hosts:preview": "npm run build && node dist/runtime/scripts/hosts-preview.mjs",
    "hosts:apply": "npm run build && sudo node dist/runtime/scripts/apply-hosts.mjs",
    "network:preview": "npm run build && node dist/runtime/scripts/hosts-preview.mjs",
    "network:apply": "npm run build && sudo node dist/runtime/scripts/apply-hosts.mjs",
    "safari:apply": "npm run build && node dist/runtime/scripts/apply-safari-filter.mjs",
    "adult:blocklist:refresh": "npm run build && node dist/runtime/scripts/refresh-adult-blocklist.mjs",
    "ios:checkpoint": "node scripts/create-ios-layout-checkpoint.mjs",
    "ios:restore-layout": "node scripts/restore-ios-home-layout.mjs",
    "ios:supervise-preserve-layout": "node scripts/supervise-ios-preserving-layout.mjs",
    "ios:apply-usb": "node scripts/apply-ios-usb-profile.mjs",
    "ios:apply-usb:watch": "node scripts/watch-ios-usb-profile.mjs",
    "ios:phone:status": "node scripts/ios-phone-suite.mjs status",
    "ios:phone:check": "node scripts/ios-phone-suite.mjs check",
    "ios:phone:audit": "node scripts/ios-phone-suite.mjs audit",
    "ios:phone:update": "node scripts/ios-phone-suite.mjs update",
    "ios:phone:bump": "node scripts/ios-phone-suite.mjs bump",
    "ios:social:build": "npm run build && node dist/runtime/scripts/build-ios-social-app.mjs",
    "ios:social:test": "npm run build && npm run ios:social:test:runtime",
    "ios:social:test:runtime": "node dist/runtime/scripts/test-ios-social.mjs",
    "ios:manageengine:export": "npm run build && node dist/runtime/scripts/export-manageengine-ios-profile.mjs",
    "ios:manageengine:apply-enrollment-window": "npm run ios:manageengine:export -- --enrollment-window && node scripts/watch-ios-usb-profile.mjs --profile data/manageengine/vigil-manageengine-enrollment-window.mobileconfig",
    "ios:mdm:identity": "npm run build && node dist/runtime/scripts/generate-ios-mdm-identity.mjs",
    "ios:mdm:doctor": "npm run build && node dist/runtime/scripts/ios-mdm-doctor.mjs",
    "ios:mdm:configure": "npm run build && node dist/runtime/scripts/configure-ios-mdm.mjs",
    "seal:source": "npm run build && node dist/runtime/scripts/seal-source.mjs",
    "doctor": "npm run build && node dist/runtime/scripts/doctor.mjs",
    "agent": "node scripts/vigil-agent.mjs",
    "install:agent": "npm run build && node dist/runtime/scripts/install-launch-agent.mjs",
    "uninstall:agent": "npm run build && node dist/runtime/scripts/uninstall-launch-agent.mjs",
    "install:system-guardian": "npm run build && sudo env PATH=\"$PATH\" node dist/runtime/scripts/install-system-guardian.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "build": {
    "appId": "tech.caseline.vigil",
    "productName": "Vigil",
    "directories": {
      "output": "dist/mac.noindex"
    },
    "files": [
      {
        "from": "dist.nosync/runtime",
        "to": "dist/runtime",
        "filter": [
          "**/*",
          "!tests/**/*",
          "!scripts/build-ios-social-app.mjs",
          "!scripts/copy-assets.mjs",
          "!scripts/dev-server.mjs",
          "!scripts/ios-phone-suite.mjs",
          "!scripts/run-tests.mjs",
          "!scripts/test-ios-social.mjs",
          "!scripts/write-build-info.mjs",
          "!**/* [0-9]*"
        ]
      },
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist.nosync/runtime/build-info.json",
      "dist.nosync/runtime/package.json",
      "dist.nosync/runtime/public/**/*",
      "dist.nosync/runtime/src/**/*",
      "dist.nosync/runtime/scripts/**/*",
      "dist.nosync/runtime/extension/**/*",
      "dist.nosync/runtime/bin/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "sign": "scripts/sign-mac.mjs",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "electron": "^42.6.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "globals": "^17.4.0",
    "typescript": "^7.0.2"
  }
}
