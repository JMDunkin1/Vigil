{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/runtime/app/main.js",
  "author": "James Dunkin",
  "description": "A local-first focus enforcement app for macOS.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/CaseLine-tech/Sentinel.git"
  },
  "scripts": {
    "app": "npm run build && electron .",
    "build": "rm -rf dist/runtime && tsc -p tsconfig.json && node dist/runtime/scripts/copy-assets.mjs",
    "build:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir -c.mac.identity=null",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg -c.mac.identity=null",
    "build:mac:signed": "npm run build && electron-builder --mac dir",
    "dist:mac:signed": "npm run build && electron-builder --mac dmg",
    "start": "npm run build && node dist/runtime/src/server.js",
    "dev": "npm run build && node --watch --watch-path=app --watch-path=src --watch-path=public --watch-path=extension --watch-path=scripts --watch-path=tsconfig.json --watch-path=package.json dist/runtime/scripts/dev-server.mjs",
    "test": "npm run build && node dist/runtime/scripts/run-tests.mjs",
    "lint": "node scripts/lint-source.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "hosts:preview": "npm run build && node dist/runtime/scripts/hosts-preview.mjs",
    "hosts:apply": "npm run build && sudo node dist/runtime/scripts/apply-hosts.mjs",
    "network:preview": "npm run build && node dist/runtime/scripts/hosts-preview.mjs",
    "network:apply": "npm run build && sudo node dist/runtime/scripts/apply-hosts.mjs",
    "safari:apply": "npm run build && node dist/runtime/scripts/apply-safari-filter.mjs",
    "adult:blocklist:refresh": "npm run build && node dist/runtime/scripts/refresh-adult-blocklist.mjs",
    "ios:checkpoint": "node scripts/create-ios-layout-checkpoint.mjs",
    "ios:restore-layout": "node scripts/restore-ios-home-layout.mjs",
    "ios:supervise-preserve-layout": "node scripts/supervise-ios-preserving-layout.mjs",
    "ios:apply-usb": "node scripts/apply-ios-usb-profile.mjs",
    "ios:apply-usb:watch": "node scripts/watch-ios-usb-profile.mjs",
    "ios:manageengine:export": "npm run build && node dist/runtime/scripts/export-manageengine-ios-profile.mjs",
    "ios:manageengine:apply-enrollment-window": "npm run ios:manageengine:export -- --enrollment-window && node scripts/watch-ios-usb-profile.mjs --profile data/manageengine/sentinel-manageengine-enrollment-window.mobileconfig",
    "ios:mdm:identity": "npm run build && node dist/runtime/scripts/generate-ios-mdm-identity.mjs",
    "ios:mdm:doctor": "npm run build && node dist/runtime/scripts/ios-mdm-doctor.mjs",
    "ios:mdm:configure": "npm run build && node dist/runtime/scripts/configure-ios-mdm.mjs",
    "seal:source": "npm run build && node dist/runtime/scripts/seal-source.mjs",
    "doctor": "npm run build && node dist/runtime/scripts/doctor.mjs",
    "install:agent": "npm run build && node dist/runtime/scripts/install-launch-agent.mjs",
    "uninstall:agent": "npm run build && node dist/runtime/scripts/uninstall-launch-agent.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "tech.caseline.sentinel",
    "productName": "Sentinel",
    "directories": {
      "output": "dist/mac"
    },
    "files": [
      "dist/runtime/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/runtime/package.json",
      "dist/runtime/public/**/*",
      "dist/runtime/src/**/*",
      "dist/runtime/scripts/**/*",
      "dist/runtime/extension/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^7.0.1-rc"
  }
}
