import { gunzipSync } from "node:zlib";

export const HISTORICAL_GUARDIAN_TEST_CONFIG = Object.freeze({
  appPath: "/Applications/Vigil.app",
  targetHome: "/Users/migration-fixture",
  targetUid: 501,
  targetUser: "migration-fixture"
} as const);

/**
 * Exact guardian program bytes emitted by each named historical source commit
 * with HISTORICAL_GUARDIAN_TEST_CONFIG. The programs are checked in as one
 * gzip-compressed JSON archive so migration tests never depend on local
 * installation state or on old Git objects being available in CI.
 */
const PACKED_HISTORICAL_GUARDIAN_PROGRAMS = "";

const decoded = JSON.parse(
  gunzipSync(Buffer.from(PACKED_HISTORICAL_GUARDIAN_PROGRAMS, "base64")).toString("utf8")
) as Record<string, unknown>;
const expectedKeys = ["legacy", "v3", "v4", "v5", "v6", "v7"] as const;
if (JSON.stringify(Object.keys(decoded).sort()) !== JSON.stringify([...expectedKeys].sort())
  || expectedKeys.some((key) => typeof decoded[key] !== "string" || !decoded[key])) {
  throw new Error("The checked-in historical guardian program archive is incomplete.");
}

export const HISTORICAL_GUARDIAN_PROGRAMS = Object.freeze(
  Object.fromEntries(expectedKeys.map((key) => [key, decoded[key] as string]))
) as Readonly<Record<(typeof expectedKeys)[number], string>>;
