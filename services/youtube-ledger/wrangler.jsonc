{
  "name": "vigil-youtube-ledger",
  "main": "../../src/youtubeSharedWorker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "LEDGERS", "class_name": "YouTubeSharedLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["YouTubeSharedLedger"] }],
  "observability": { "enabled": false }
}
